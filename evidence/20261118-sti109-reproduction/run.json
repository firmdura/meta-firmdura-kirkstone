        "-c",
        "\nimport hashlib, json, os, pathlib\nroot = pathlib.Path(\"/work/build-baseline/tmp/deploy\")\nfor dirpath, dirnames, filenames in os.walk(root, followlinks=False):\n    dirnames.sort()\n    filenames.sort()\n    for name in dirnames + filenames:\n        p = pathlib.Path(dirpath) / name\n        rel = p.relative_to(root).as_posix()\n        if p.is_symlink():\n            print(json.dumps({\"path\": rel, \"target\": os.readlink(p), \"type\": \"symlink\"}, sort_keys=True))\n        elif p.is_file():\n            with p.open(\"rb\") as f:\n                digest = hashlib.file_digest(f, \"sha256\").hexdigest()\n            print(json.dumps({\"path\": rel, \"sha256\": digest, \"size\": p.stat().st_size, \"type\": \"file\"}, sort_keys=True))\n"
      ],
      "cwd": "<checkout>",
